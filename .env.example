# PALPASS — Environment Variables Template
# Copy this file to `.env.local` and fill each key. NO real secrets belong here.
# Values below are placeholders only.

# ── Supabase (Required) ──────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY

# Supabase Service Role (Server-Side ONLY — NEVER expose to client or ship)
# Used only in Server Actions / API routes for admin operations.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── App Config ────────────────────────────────────────────────────────────────
# In production this MUST be the official public domain (e.g. https://palpass.ps)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PALPASS

# ── Storage Bucket Names ──────────────────────────────────────────────────────
NEXT_PUBLIC_BUCKET_AVATARS=avatars
NEXT_PUBLIC_BUCKET_DOCS=verification-docs
NEXT_PUBLIC_BUCKET_MENUS=menus
NEXT_PUBLIC_BUCKET_RESTAURANTS=restaurant-images
NEXT_PUBLIC_BUCKET_JOBS=job-images

# ── SMTP (production registration/forgot-password email) ─────────────────────
# Only one of the pair below is required depending on the code path used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_SENDER@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=PALPASS

# ── Database (LOCAL SCRIPTS / TEST SUITES ONLY — the app never reads these) ──
# Used by scripts/*.mjs integration suites (test:auth, test:civic) and CI.
# For staging CI use a dedicated non-production Supabase project below.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-N-REGION-N.pooler.supabase.com:6543/postgres

# ── Optional / Future ─────────────────────────────────────────────────────────
# RESEND_API_KEY=